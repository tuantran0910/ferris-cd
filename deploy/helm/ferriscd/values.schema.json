{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "FerrisCD Helm Chart Values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "apiPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "authPolicy": { "type": "string", "enum": ["token-review", "deny-all", "pass-through"] },
        "workRoot": { "type": "string", "minLength": 1 },
        "allowLocalRepos": { "type": "boolean" },
        "allowInsecureClusterTls": { "type": "boolean" }
      }
    },
    "leaderElection": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "leaseName": { "type": "string" },
        "leaseDurationSeconds": { "type": "integer", "minimum": 4 },
        "renewIntervalSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "sharding": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "shardId": { "type": ["integer", "null"], "minimum": 0 },
        "totalShards": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "multiTenant": {
      "type": "object",
      "properties": {
        "applicationNamespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "impersonation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "manageCrds": { "type": "boolean" },
        "manageRbacResources": { "type": "boolean" },
        "applicationsets": { "type": "boolean" },
        "applicationsetPrune": { "type": "boolean" }
      }
    },
    "rbacPolicy": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subject", "project", "actions"],
            "properties": {
              "subject": {
                "type": "object",
                "required": ["kind", "name"],
                "properties": {
                  "kind": { "type": "string", "enum": ["user", "group"] },
                  "name": { "type": "string", "minLength": 1 }
                }
              },
              "project": { "type": "string", "minLength": 1 },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": ["get", "diff", "sync", "rollback", "admin"]
                }
              }
            }
          }
        }
      }
    },
    "defaultProject": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "sourceNamespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": ["boolean", "null"] },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "egress": {
          "type": "object",
          "properties": {
            "kubeApi": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "cidrs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "except": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "allowSameNamespace": { "type": "boolean" },
            "allowApiProxyEgress": { "type": "boolean" }
          }
        }
      }
    }
  }
}
